# 屏识AI助手远端服务环境变量模板
# 复制为 .env（勿提交真实值）或直接注入进程环境。
# Windows PowerShell: $env:TIANYI_API_KEY="<真实key>"

# 天翼 OpenAI 兼容端点与凭据（必填 key，缺失时 /v1/answer 返回 503）
TIANYI_BASE_URL=https://ai.ctaigw.cn/v1
TIANYI_API_KEY=
TIANYI_MODEL=glm-5.3-flash

# Redis 连接（Docker compose 内使用 redis://redis:6379/0）
REDIS_URL=redis://127.0.0.1:6379/0

# 去重 TTL（秒），执行计划固定默认 24 小时
DEDUP_TTL_SECONDS=86400

# 句子规范化后最大长度（字符）
MAX_SENTENCE_CHARS=2000

# 模型请求总超时 / 连接超时（秒）
MODEL_TIMEOUT_SECONDS=30
MODEL_CONNECT_TIMEOUT_SECONDS=5

# 普通融合的进程内执行与等待场次上限
LIVE_FUSION_CONCURRENCY=2
LIVE_FUSION_QUEUE_LIMIT=16
